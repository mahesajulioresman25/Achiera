// ============================================
// ACHIERA AUTONOMOUS ANALYTICS SYSTEM
// Complete Prisma Schema Extension
// ============================================

model RawImportFile {
  id      String @id @default(uuid())
  brandId String @map("brand_id")

  // File metadata
  fileName        String @map("file_name") @db.VarChar(255)
  fileType        String @map("file_type") @db.VarChar(10) // 'csv' | 'excel'
  fileSizeBytes   BigInt @map("file_size_bytes")
  fileHash        String @map("file_hash") @db.VarChar(64) // SHA256
  fileStoragePath String @map("file_storage_path") @db.Text

  // Upload info
  uploadTimestamp DateTime @default(now()) @map("upload_timestamp")
  uploadedBy      String   @map("uploaded_by")
  platformHint    String?  @map("platform_hint") @db.VarChar(50)

  // Processing status
  processingStatus String @default("pending") @map("processing_status") @db.VarChar(20)
  rowCount         Int    @default(0) @map("row_count")
  validRowCount    Int    @default(0) @map("valid_row_count")
  errorRowCount    Int    @default(0) @map("error_row_count")

  // Processing timestamps
  processingStartedAt   DateTime? @map("processing_started_at")
  processingCompletedAt DateTime? @map("processing_completed_at")

  // Relations
  brand           Brand                   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  rawRows         RawRow[]
  schemaMappings  InferredSchemaMapping[]
  confidenceScore SchemaConfidenceScore?

  @@unique([brandId, fileHash], map: "RawImportFile_unique_brand_file_hash_key")
  @@index([brandId, uploadTimestamp], map: "RawImportFile_idx_brand_upload_idx")
  @@index([processingStatus], map: "RawImportFile_idx_processing_status_idx")
  @@map("raw_import_files")
}

model RawRow {
  id        String @id @default(uuid())
  fileId    String @map("file_id")
  brandId   String @map("brand_id")
  rowNumber Int    @map("row_number")

  // Raw data (JSON)
  rawData Json @map("raw_data")

  // Inference results
  inferredType      String?  @map("inferred_type") @db.VarChar(50) // 'sales' | 'ads' | 'inventory'
  inferredPlatform  String?  @map("inferred_platform") @db.VarChar(50)
  mappingConfidence Decimal? @map("mapping_confidence") @db.Decimal(3, 2)

  // Validation
  validationStatus   String @default("pending") @map("validation_status") @db.VarChar(20)
  validationErrors   Json?  @map("validation_errors")
  validationWarnings Json?  @map("validation_warnings")

  // Processing
  processedAt       DateTime? @map("processed_at")
  canonicalRecordId String?   @map("canonical_record_id") // Link to canonical table

  // Relations
  file  RawImportFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  brand Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([fileId, rowNumber], map: "RawRow_idx_file_row_idx")
  @@index([brandId, validationStatus], map: "RawRow_idx_brand_validation_idx")
  @@index([canonicalRecordId], map: "RawRow_idx_canonical_link_idx")
  @@map("raw_rows")
}

model InferredSchemaMapping {
  id      String @id @default(uuid())
  fileId  String @map("file_id")
  brandId String @map("brand_id")

  // Source column
  sourceColumnName  String @map("source_column_name") @db.VarChar(255)
  sourceColumnIndex Int    @map("source_column_index")

  // Canonical mapping
  canonicalField String @map("canonical_field") @db.VarChar(100)

  // Inference method
  inferenceMethod String  @map("inference_method") @db.VarChar(50)
  confidenceScore Decimal @map("confidence_score") @db.Decimal(3, 2)

