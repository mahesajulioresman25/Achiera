// Audit Log - Immutable record of all critical actions
model AuditLog {
  id String @id @default(cuid())

  // Who
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  userName String // Denormalized for historical accuracy
  userRole String

  // What
  action     AuditAction
  entityType String // "Budget", "ICTransaction", "JournalEntry", etc.
  entityId   String // ID of the affected entity

  // When
  timestamp DateTime @default(now())

  // Where
  ipAddress String?
  userAgent String?

  // Details
  changes  Json? // Before/After snapshot
  details  String? @db.Text
  metadata Json? // Additional context

  // Brand context
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  // Risk level
  severity AuditSeverity @default(INFO)

  createdAt DateTime @default(now())

  @@index([userId, timestamp])
  @@index([brandId, timestamp])
  @@index([entityType, entityId])
  @@index([action, timestamp])
  @@map("audit_logs")
}

enum AuditAction {
  // Budget actions
  BUDGET_CREATED
  BUDGET_APPROVED
  BUDGET_REJECTED
  BUDGET_MODIFIED
  RULE_PAUSED
  RULE_RESUMED
  RULE_EXPANDED
  RULE_DEMOTED

  // IC Transaction actions
  IC_TRANSACTION_CREATED
  IC_TRANSACTION_APPROVED
  IC_TRANSACTION_REJECTED

  // Journal actions
  JOURNAL_ENTRY_CREATED
  JOURNAL_ENTRY_MODIFIED
  JOURNAL_ENTRY_DELETED

  // Financial actions
  INVOICE_CREATED
  INVOICE_PAID
  EXPENSE_RECORDED
  ASSET_CREATED
  ASSET_DEPRECIATED

  // User actions
  USER_LOGIN
  USER_LOGOUT
  ROLE_CHANGED
  PERMISSION_MODIFIED

  // System actions
  SETTINGS_CHANGED
  POLICY_UPDATED
  DATA_EXPORTED

  // Autonomous system actions
  EXECUTION_STARTED
  EXECUTION_COMPLETED
  EXECUTION_FAILED
  BUDGET_CONSUMPTION

  // Compliance actions
  COMPLIANCE_REPORT_GENERATED
  SENSITIVE_DATA_ACCESS
  SECURITY_LOGIN_SUCCESS
  SECURITY_LOGIN_FAILURE
  ROLE_CHANGE
  BRAND_FREEZE
  KILL_SWITCH_ACTIVATED
  SYSTEM_CONFIG_CHANGE
}

enum AuditSeverity {
  INFO // Normal operations
  WARNING // Unusual but not critical
  CRITICAL // Requires immediate attention
  SECURITY // Security-related events
}

// Compliance Rules - Define what's allowed/required
model ComplianceRule {
  id String @id @default(cuid())

  name        String
  description String             @db.Text
  category    ComplianceCategory

  // Rule definition
  ruleType   RuleType
  conditions Json // Rule logic in JSON format

  // Enforcement
  isActive Boolean            @default(true)
  severity ComplianceSeverity

  // Scope
  brandId String? // null = applies to all brands
  brand   Brand?  @relation(fields: [brandId], references: [id])

  // Violations
  violations ComplianceViolation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, category])
  @@index([brandId])
  @@map("compliance_rules")
}

enum ComplianceCategory {
  FINANCIAL_POLICY
  APPROVAL_WORKFLOW
  DATA_INTEGRITY
  REGULATORY
  OPERATIONAL
  SECURITY
}

enum RuleType {
  THRESHOLD // e.g., "Expenses > Rp 10jt need approval"
  MANDATORY_FIELD // e.g., "All invoices must have PO number"
  WORKFLOW // e.g., "Budget changes need CFO approval"
  TIMING // e.g., "Month-end close by 5th of next month"
  SEGREGATION // e.g., "Same person can't create & approve"
  LIMIT // e.g., "Max 3 failed login attempts"
}

enum ComplianceSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Compliance Violations - Track when rules are broken
model ComplianceViolation {
  id String @id @default(cuid())

  ruleId String
  rule   ComplianceRule @relation(fields: [ruleId], references: [id])

  // Context
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Details
  entityType  String
  entityId    String
  description String @db.Text

  // Status
  status     ViolationStatus @default(OPEN)
  resolvedBy String?
  resolvedAt DateTime?
  resolution String?         @db.Text

  // Severity (inherited from rule but can be overridden)
  severity ComplianceSeverity

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, severity])
  @@index([brandId, createdAt])
  @@index([ruleId])
  @@map("compliance_violations")
}

enum ViolationStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  WAIVED
  FALSE_POSITIVE
}

// ============================================
// CONSOLIDATED FINANCIAL STATEMENTS
// ============================================

// Consolidated Statement - Snapshot of consolidated financials
model ConsolidatedStatement {
  id String @id @default(cuid())

  // Period
  fiscalYear Int
  period     ConsolidationPeriod
  startDate  DateTime
  endDate    DateTime

  // P&L Data
  totalRevenue  Decimal @db.Decimal(15, 2)
  totalCOGS     Decimal @db.Decimal(15, 2)
  totalExpenses Decimal @db.Decimal(15, 2)
  netProfit     Decimal @db.Decimal(15, 2)

  // Balance Sheet Data
  totalAssets      Decimal @db.Decimal(15, 2)
  totalLiabilities Decimal @db.Decimal(15, 2)
  totalEquity      Decimal @db.Decimal(15, 2)

  // Cash Flow Data
  operatingCashFlow Decimal @db.Decimal(15, 2)
  investingCashFlow Decimal @db.Decimal(15, 2)
  financingCashFlow Decimal @db.Decimal(15, 2)

  // IC Elimination Summary
  icEliminationAmount Decimal @db.Decimal(15, 2)
  icTransactionCount  Int

  // Metadata
  generatedBy String
  generatedAt DateTime @default(now())
  notes       String?  @db.Text

  // Detailed breakdown (JSON)
  plDetails      Json // Detailed P&L by brand
  bsDetails      Json // Detailed BS by brand
  cfDetails      Json // Detailed CF by brand
  icEliminations Json // IC elimination details

