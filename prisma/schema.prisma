generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id                           String                      @id @default(cuid())
  slug                         String                      @unique
  name                         String
  isActive                     Boolean                     @default(true)
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt
  paymentSettings              Json?
  adCampaigns                  AdCampaign[]
  aiExplanationLogs            AIExplanationLog[]
  analyticsEvents              AnalyticsEvent[]
  anomalies                    Anomaly[]
  approvalActions              ApprovalAction[]
  approvalEscalations          ApprovalEscalation[]
  approvalPolicy               ApprovalPolicy?
  approvalRequests             ApprovalRequest[]
  assistedActions              AssistedAction[]
  auditLogs                    AuditLog[]
  brandConfig                  BrandConfig?
  budgetPolicy                 BudgetPolicy?
  businessAssets               BusinessAsset[]
  catalogueRequests            CatalogueRequest[]
  merchCollections             MerchCollection[]
  mockupConfigs                MockupConfig[]
  mockupProductTemplates       MockupProductTemplate[]
  customerReviews              CustomerReview[]
  decisionRules                DecisionRule[]
  demandForecasts              DemandForecast[]
  lifecycleSteps               DevelopmentLifecycleStep[]
  emailIntegrations            EmailIntegration[]
  executionLogs                ExecutionLog[]
  executiveConfidenceReviews   ExecutiveConfidenceReview[]
  failureSimulations           FailureSimulation[]
  frozenCategories             FrozenCategory[]
  inventoryCategories          InventoryCategory[]
  frozenSettings               FrozenSettings?
  heroSlides                   HeroSlide[]
  humanAgreementSignals        HumanAgreementSignal[]
  transfersReceived            InterBrandTransfer[]        @relation("TransfersReceived")
  transfersSent                InterBrandTransfer[]        @relation("TransfersSent")
  itCaseStudies                ItCaseStudy[]
  itServices                   ItService[]
  itSettings                   ItSettings?
  journalTransactions          JournalTransaction[]
  ledgerAccounts               LedgerAccount[]
  loyaltyAccounts              LoyaltyAccount[]
  loyaltyMembers               LoyaltyMember[]
  loyaltyRewards               LoyaltyReward[]
  manualOverrides              ManualOverride[]
  marketplaceCampaignReports   MarketplaceCampaignReport[]
  marketplaceDailySales        MarketplaceDailySales[]
  marketplaceInsights          MarketplaceInsight[]
  merchSettings                MerchSettings?
  orders                       Order[]
  pricingRules                 PricingRule[]
  productMappings              ProductMapping[]
  productionPlans              ProductionPlan[]
  recipes                      Recipe[]
  stockAlerts                  StockAlert[]
  subscriptions                Subscription[]
  suggestionDrafts             SuggestionDraft[]
  trustMetricsHistory          TrustMetricsHistory[]
  userRoles                    UserBrandRole[]
  warehouses                   Warehouse[]
  whatsappCampaigns            WhatsAppCampaign[]
  whatsappQueue                WhatsAppQueue[]
  interCompanyTransactionsFrom InterCompanyTransaction[]   @relation("FromBrand")
  interCompanyTransactionsTo   InterCompanyTransaction[]   @relation("ToBrand")
  budgets                      Budget[]
  complianceRules              ComplianceRule[]
  complianceViolations         ComplianceViolation[]
  cashFlowForecasts            CashFlowForecast[]
  liquidityRisks               LiquidityRisk[]
  reserveRecommendations       ReserveRecommendation[]
  bankAccounts                 BankAccount[]
  SettlementBatch              SettlementBatch[]
  flashSaleConfigs             FlashSaleConfig[]
  campaigns                    Campaign[]
  subscriptionPlans            SubscriptionPlan[]
  level3Whitelists             Level3Whitelist[]
  rawImportFiles               RawImportFile[]
  rawRows                      RawRow[]
  inferredSchemaMappings       InferredSchemaMapping[]
  canonicalSalesTransactions   CanonicalSalesTransaction[]
  canonicalAdsMetrics          CanonicalAdsMetric[]
  salesFacts                   SalesFact[]
  adsPerformanceFacts          AdsPerformanceFact[]
  aggDailySales                AggDailySales[]
  aggDailyAds                  AggDailyAds[]
  aggWeeklyTrends              AggWeeklyTrends[]
  dailySalesSnapshots          AnalyticsDailySales[]
  dailyAdsSnapshots            AnalyticsDailyAds[]
  weeklyTrends                 AnalyticsWeeklyTrends[]
  recommendations              Recommendation[]
  salesImports                 SalesImportRaw[]
  adsImports                   AdsImportRaw[]
  complianceReports            ComplianceReport[]
  recipePosts                  RecipePost[]
  stockMutations               StockMutation[]

  @@map("brands")
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  passwordHash         String
  emailVerified        Boolean               @default(false)
  phone                String? // WhatsApp number for contact
  address              String?               @db.Text // Delivery address
  profileImage         String?               @db.Text // Profile photo URL
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  globalRole           GlobalRole            @default(USER)
  auditLogs            AuditLog[]
  loyaltyAccounts      LoyaltyAccount[]
  subscriptions        Subscription[]
  brandRoles           UserBrandRole[]
  complianceViolations ComplianceViolation[]
  verificationTokens   VerificationToken[]

  @@map("users")
}

model UserBrandRole {
  id        String    @id @default(cuid())
  userId    String
  brandId   String
  role      BrandRole
  createdAt DateTime  @default(now())
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, brandId])
  @@index([brandId], map: "UserBrandRole_user_brand_roles_brandId_idx")
  @@map("user_brand_roles")
}

model HeroSlide {
  id        String    @id @default(cuid())
  brandId   String
  title     String    @db.Text
  subtitle  String    @db.Text
  tagline   String?   @db.Text
  ctaLabel  String?
  ctaLink   String?
  mediaType MediaType @default(IMAGE)
  imageUrl  String?   @db.Text
  videoUrl  String?   @db.Text
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId], map: "HeroSlide_hero_slides_brandId_idx")
  @@map("hero_slides")
}

model AnalyticsEvent {
  id             String             @id @default(cuid())
  brandId        String
  type           AnalyticsEventType
  path           String?
  collectionSlug String?
  userAgent      String?            @db.Text
  ipHash         String?
  createdAt      DateTime           @default(now())
  metadata       Json?
  referrer       String?            @db.Text
  sessionId      String?
  brand          Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, type, createdAt])
  @@index([brandId, sessionId])
  @@index([brandId, path])
  @@map("analytics_events")
}

model MerchSettings {
  id             Int      @id @default(autoincrement())
  heroTitle      String   @db.Text
  heroSubtitle   String   @db.Text
  heroTagline    String   @db.Text
  heroCtaLabel   String
  heroCtaLink    String
  highlightLine  String   @db.Text
  mockupTitle    String   @db.Text
  mockupSubtitle String   @db.Text
  mockupTagline  String   @db.Text
  mockupEnabled  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  brandId        String   @unique
  heroMode       HeroMode @default(SINGLE)
  brand          Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("merch_settings")
}

model MerchCollection {
  id               String              @id @default(cuid())
  brandId          String
  slug             String
  name             String
  description      String?             @db.Text
  coverImage       String?             @db.Text
  visibility       String              @default("draft")
  status           String              @default("active")
  heroTitle        String              @db.Text
  heroSubtitle     String              @db.Text
  highlights       Json?
  whatsInside      Json?
  designOptions    Json?
  materialPoints   Json?
  useCases         Json?
  packagingOptions Json?
  faq              Json?
  galleryImages    Json?
  metaTitle        String?             @db.Text
  metaDescription  String?             @db.Text
  displayOrder     Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  brand            Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  products         CollectionProduct[]

  @@unique([brandId, slug])
  @@map("collections")
}

model CollectionProduct {
  id           String @id @default(cuid())
  collectionId String
  productId    String

  // Display in collection
  showcaseImage  String? @db.Text
  showcaseImages Json? // array of additional image URLs (optional)
  displayOrder   Int     @default(0)
  featured       Boolean @default(false)

  // Collection-specific overrides
  description String? @db.Text
  highlights  Json? // array of strings

  // Material & Printing Info
  materialInfo    String? @db.Text
  printingMethods Json? // array of allowed methods: ["PLASTISOL", "DTF", "DTG", "EMBROIDERY"]
  specifications  Json? // { "weight": "...", "dimensions": "...", etc }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collection MerchCollection       @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    MockupProductTemplate @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@map("collection_products")
}

model MockupProductTemplate {
  id          String @id @default(cuid())
  brandId     String
  slug        String @unique
  displayName String
  productType String

  canvasWidth  Int @default(2000)
  canvasHeight Int @default(2000)

  // New Fields
  defaultRatio String? // e.g. "1:1"
  description  String? @db.Text

  hasVariants Boolean @default(true)

  variants           MockupVariant[]
  orders             Order[]
  collectionProducts CollectionProduct[]
  mockupTemplates    MockupTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("mockup_product_templates")
}

model MockupVariant {
  id          String  @id @default(cuid())
  templateId  String
  name        String
  description String?

  baseImageUrl   String  @db.Text
  tintMaskUrl    String? @db.Text
  colorHex       String? // For UI Swatch
  safeZoneX      Float
  safeZoneY      Float
  safeZoneWidth  Float
  safeZoneHeight Float

  // Back View (Optional)
  backImageUrl       String? @db.Text
  backSafeZoneX      Float?
  backSafeZoneY      Float?
  backSafeZoneWidth  Float?
  backSafeZoneHeight Float?

  // Pricing & Config
  price            Decimal @default(0) @db.Decimal(10, 2)
  additionalConfig Json? // For future flexibility

  orderIndex Int     @default(0)
  isActive   Boolean @default(true)

  template        MockupProductTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  orders          Order[]
  orderItems      OrderItem[]
  mockupTemplates MockupTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mockup_variants")
}

model MockupConfig {
  id      String @id @default(cuid())
  brandId String

  productType         String // "tote", "tshirt", "hoodie", "tumbler", "bag"
  displayName         String
  baseImages          Json // mapping color -> image path
  baseImageUrl        String? @db.Text // Single base image for tinting
  colorOptions        Json? // Array of { key, label, hex }
  safeZoneX           Int     @default(0)
  safeZoneY           Int     @default(0)
  safeZoneWidth       Int     @default(200)
  safeZoneHeight      Int     @default(200)
  isActive            Boolean @default(true)
  isDefaultForBuilder Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  brand         Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  colorVariants MockupColorVariant[]

  @@map("mockup_configs")
}

model MockupColorVariant {
  id           String   @id @default(cuid())
  templateId   String
  key          String // "black", "white", "red"
  label        String // "Black", "White", "Red"
  swatchHex    String // "#111827" for button display
  imageUrl     String   @db.Text // URL to final PNG
  backImageUrl String?  @db.Text // URL to back side PNG
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  template MockupConfig @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("mockup_color_variants")
}

model MockupTemplate {
  id                  String                @id @default(cuid())
  productId           String
  variantId           String?
  canvasWidth         Int
  canvasHeight        Int
  aspectRatio         String?
  printAreaX          Float
  printAreaY          Float
  printAreaWidth      Float
  printAreaHeight     Float
  safeAreaX           Float
  safeAreaY           Float
  safeAreaWidth       Float
  safeAreaHeight      Float
  hasBackView         Boolean               @default(false)
  backPrintAreaX      Float?
  backPrintAreaY      Float?
  backPrintAreaWidth  Float?
  backPrintAreaHeight Float?
  backSafeAreaX       Float?
  backSafeAreaY       Float?
  backSafeAreaWidth   Float?
  backSafeAreaHeight  Float?
  frontMockupImage    String?               @db.Text
  backMockupImage     String?               @db.Text
  tintMaskUrl         String?               @db.Text
  maxColors           Int?
  allowedFormats      Json?
  minResolution       Int?
  maxFileSize         Int?
  layersConfig        Json?
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  product             MockupProductTemplate @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant             MockupVariant?        @relation(fields: [variantId], references: [id])

  @@index([productId], map: "MockupTemplate_mockup_templates_productId_idx")
  @@index([variantId], map: "MockupTemplate_mockup_templates_variantId_idx")
  @@map("mockup_templates")
}

model CatalogueRequest {
  id          String   @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String?  @db.Text
  notes       String?  @db.Text
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId], map: "CatalogueRequest_catalogue_requests_brandId_idx")
  @@map("catalogue_requests")
}

model ItSettings {
  id           Int      @id @default(autoincrement())
  brandId      String   @unique
  heroMode     HeroMode @default(SINGLE)
  heroTitle    String   @db.Text
  heroSubtitle String   @db.Text
  heroTagline  String?  @db.Text
  heroCtaLabel String?
  heroCtaLink  String?
  aboutTitle   String?  @db.Text
  aboutContent String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  brand        Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("it_settings")
}

model ItService {
  id          String   @id @default(cuid())
  brandId     String
  slug        String
  name        String
  description String   @db.Text
  icon        String?
  features    Json?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, slug])
  @@map("it_services")
}

model ItCaseStudy {
  id          String   @id @default(cuid())
  brandId     String
  slug        String
  title       String
  subtitle    String?  @db.Text
  client      String?
  industry    String?
  duration    String?
  teamSize    String?
  context     String?  @db.Text
  challenge   String?  @db.Text
  solution    String?  @db.Text
  results     String?  @db.Text
  techStack   Json?
  images      Json?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, slug])
  @@map("it_case_studies")
}

model DevelopmentLifecycleStep {
  id          String   @id @default(cuid())
  brandId     String
  title       String
  description String   @db.Text
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId], map: "dev_lifecycle_steps_brandId_idx")
  @@map("development_lifecycle_steps")
}

model FrozenSettings {
  id               Int      @id @default(autoincrement())
  brandId          String   @unique
  heroTitle        String   @db.Text
  subscriptionInfo String?  @db.Text
  minOrderAmount   Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  brand            Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("frozen_settings")
}

model FrozenCategory {
  id           String          @id @default(cuid())
  brandId      String
  name         String
  slug         String
  description  String?         @db.Text
  image        String?
  displayOrder Int             @default(0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  brand        Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  products     FrozenProduct[]

  @@unique([brandId, slug])
  @@map("frozen_categories")
}

model InventoryCategory {
  id        String          @id @default(cuid())
  brandId   String
  name      String
  slug      String
  type      InventoryType   @default(RAW_MATERIAL)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  brand     Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  materials FrozenProduct[]

  @@unique([brandId, slug])
  @@map("inventory_categories")
}

model FrozenProduct {
  id                  String             @id @default(cuid())
  categoryId          String?
  inventoryCategoryId String?
  name                String
  slug                String             @unique
  description         String?            @db.Text
  image               String?
  ingredients         String?            @db.Text
  nutrition           Json?
  storageType         String
  shelfLife           Int?
  viewCount           Int                @default(0)
  orderCount          Int                @default(0)
  isFeatured          Boolean            @default(false)
  featuredOrder       Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  category            FrozenCategory?    @relation(fields: [categoryId], references: [id])
  inventoryCategory   InventoryCategory? @relation(fields: [inventoryCategoryId], references: [id])
  variants            FrozenVariant[]
  inventoryType       InventoryType      @default(FINISHED_GOOD)
  recipeProducts      RecipeProduct[]

  @@index([categoryId], map: "FrozenProduct_frozen_products_categoryId_idx")
  @@index([isFeatured, featuredOrder])
  @@index([orderCount])
  @@map("frozen_products")
}

model FrozenVariant {
  id                       String                    @id @default(cuid())
  productId                String
  name                     String
  sku                      String                    @unique
  price                    Decimal                   @db.Decimal(12, 2)
  costPrice                Decimal                   @default(0.00) @db.Decimal(12, 2)
  weight                   Decimal
  stockOnHand              Int                       @default(0)
  unit                     String                    @default("gram")
  // Comprehensive Pricing Fields
  operationalCostPerUnit   Decimal?                  @map("operational_cost_per_unit") @db.Decimal(12, 2)
  marketplaceFeeRate       Decimal?                  @default(0.1500) @map("marketplace_fee_rate") @db.Decimal(5, 4) // 15%
  targetMargin             Decimal?                  @default(0.3000) @map("target_margin") @db.Decimal(5, 4) // 30%
  sellingPrice             Decimal?                  @map("selling_price") @db.Decimal(12, 2) // Auto-calculated
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  demandForecasts          DemandForecast[]
  product                  FrozenProduct             @relation(fields: [productId], references: [id], onDelete: Cascade)
  batches                  InventoryBatch[]
  orderItems               OrderItem[]
  priceHistory             PriceHistory[]
  productMappings          ProductMapping[]
  recipeItems              RecipeItem[]
  recipes                  Recipe?
  stockAlerts              StockAlert[]
  StockMutation            StockMutation[]
  subscriptionItems        SubscriptionItem[]
  subscriptionPlanProducts SubscriptionPlanProduct[]
  flashSaleItems           FlashSaleItem[]
  bundleItems              BundleItem[]

  @@index([productId], map: "FrozenVariant_frozen_variants_productId_idx")
  @@map("frozen_variants")
}

model InventoryBatch {
  id          String        @id @default(cuid())
  variantId   String
  batchCode   String
  quantity    Int
  receivedAt  DateTime      @default(now())
  expiryDate  DateTime
  isExpired   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  warehouseId String
  variant     FrozenVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])

  @@index([variantId, expiryDate])
  @@index([warehouseId])
  @@map("inventory_batches")
}

model Subscription {
  id              String                 @id @default(cuid())
  userId          String
  brandId         String
  customerName    String                 @map("customer_name")
  customerPhone   String                 @map("customer_phone")
  customerEmail   String?                @map("customer_email")
  customerAddress String                 @map("customer_address") @db.Text
  customerNote    String?                @map("customer_note") @db.Text
  status          String
  interval        String
  paymentMethod   String?                @map("payment_method") // BANK_TRANSFER, QRIS, etc.
  nextPaymentDate DateTime
  endDate         DateTime?              @map("end_date")
  deliveryDays    Json?                  @map("delivery_days")
  paymentProof    String?                @map("payment_proof") @db.Text
  lastOrderDate   DateTime?              @map("last_order_date")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  items           SubscriptionItem[]
  deliveries      SubscriptionDelivery[]
  brand           Brand                  @relation(fields: [brandId], references: [id])
  user            User                   @relation(fields: [userId], references: [id])
  planId          String?                @map("plan_id")
  plan            SubscriptionPlan?      @relation(fields: [planId], references: [id])

  @@index([brandId], map: "Subscription_subscriptions_brandId_idx")
  @@index([userId], map: "Subscription_subscriptions_userId_idx")
  @@index([planId])
  @@map("subscriptions")
}

model SubscriptionItem {
  id             String        @id @default(cuid())
  subscriptionId String
  variantId      String
  quantity       Int
  note           String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  variant        FrozenVariant @relation(fields: [variantId], references: [id])

  @@index([subscriptionId], map: "SubscriptionItem_subscription_items_subscriptionId_idx")
  @@index([variantId], map: "SubscriptionItem_subscription_items_variantId_idx")
  @@map("subscription_items")
}

enum DeliveryStatus {
  SCHEDULED
  PREPARING
  DELIVERED
  FAILED
  CANCELLED
}

model SubscriptionDelivery {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  deliveryDate DateTime
  status       DeliveryStatus @default(SCHEDULED)

  // Stock tracking
  stockDeducted Boolean    @default(false)
  warehouseId   String?
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])

  // Metadata
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId])
  @@index([deliveryDate, status])
  @@index([warehouseId])
  @@map("subscription_deliveries")
}

model Order {
  id                     String                  @id @default(cuid())
  invoiceNo              String                  @unique
  manualRef              String?                 @unique
  quantity               Int
  subtotal               Decimal                 @db.Decimal(12, 2)
  tax                    Decimal                 @default(0.00) @db.Decimal(12, 2)
  total                  Decimal                 @db.Decimal(12, 2)
  customerName           String
  customerEmail          String?
  customerPhone          String?
  customerAddress        String?                 @db.Text
  customerNote           String?                 @db.Text
  mockupResultPath       String?                 @db.Text
  designUploadPath       String?                 @db.Text
  isGift                 Boolean                 @default(false) @map("is_gift")
  giftMessage            String?                 @map("gift_message") @db.Text
  recipientName          String?                 @map("recipient_name")
  recipientEmail         String?                 @map("recipient_email")
  status                 String                  @default("DIPESAN")
  termsAccepted          Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  brandId                String?                 @map("brand_id")
  channel                String                  @default("WEBSITE")
  externalOrderId        String?                 @map("external_order_id")
  syncedFromEmail        Boolean                 @default(false)
  emailSyncedAt          DateTime?
  internalNotes          String?                 @db.Text
  operatorId             String?                 @map("operator_id")
  paymentMethod          String?                 @map("payment_method")
