  brandsProcessed Int
  icEliminated    Int
  errors          Json?

  // Result
  statementId String?

  executedBy String

  @@index([fiscalYear, period])
  @@index([status])
  @@map("consolidation_logs")
}

enum ConsolidationStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

