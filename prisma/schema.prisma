}

// Consolidation Log - Track consolidation runs
model ConsolidationLog {
  id String @id @default(cuid())

  fiscalYear Int
  period     ConsolidationPeriod

  status      ConsolidationStatus
  startedAt   DateTime            @default(now())
  completedAt DateTime?

